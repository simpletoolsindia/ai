{
	// Default ai models.json.
	//
	// Written to ~/.ai/agent/models.json the first time you run `ai`
	// (when the file does not yet exist). Edit the file any time — the
	// model picker reloads on each open. See docs/models.md for the
	// full reference.
	//
	// Each entry below either auto-discovers a local server (Ollama /
	// LM Studio / vLLM) or is a placeholder you fill in with an API
	// key. Lines starting with // are comments and are stripped on
	// load.
	//
	// Quick start:
	//   1. Install Ollama (https://ollama.com) and pull a model:
	//        ollama pull gemma4:e2b
	//   2. Open `/model` in ai — your local models are listed.
	//   3. For cloud providers, run `/login` and add a key.
	//
	// Local-model performance hints (the defaults below are tuned for
	// snappy local inference on consumer hardware; tune for your box):
	//
	//   num_ctx:        context window in tokens. The Ollama default
	//                   (2048) is the sweet spot for coding tasks.
	//                   Bigger = slower. Most agents never use more
	//                   than 2-4K tokens of context per turn, so 2K
	//                   keeps inference ~2x faster than 8K.
	//   num_gpu:        number of model layers to offload to GPU.
	//                   Omit to let Ollama auto-detect.
	//   num_thread:     CPU threads. Omit to let Ollama auto-detect.
	//   keep_alive:     how long Ollama keeps the model in memory
	//                   after the last request. "30m" avoids the
	//                   5-10 s cold-start on every turn.
	//
	// To see the live settings for the running model, run
	// `/diag ollama` in ai. It prints `ollama ps`, the configured
	// model, and per-model options.

	"providers": {
		// Local Ollama. The `autoDiscover: "ollama"` flag tells ai to
		// query `GET /api/tags` on first use and populate the model
		// list from whatever you have pulled. No apiKey is required
		// (Ollama ignores it).
		"ollama": {
			"baseUrl": "http://localhost:11434/v1",
			"api": "openai-completions",
			"apiKey": "ollama",
			"autoDiscover": "ollama",
			"optionalApiKey": true,
			"models": []
		},

		// LM Studio (https://lmstudio.ai). The `autoDiscover: "openai"`
		// flag queries `GET /v1/models` and lists whatever is loaded.
		// Uncomment the block below to enable it. The default port
		// 1234 is what LM Studio serves on; change it if you moved it.
		// "lmstudio": {
		//   "baseUrl": "http://localhost:1234/v1",
		//   "api": "openai-completions",
		//   "apiKey": "lmstudio",
		//   "autoDiscover": "openai",
		//   "optionalApiKey": true,
		//   "models": []
		// },

		// vLLM (https://docs.vllm.ai) - High-performance LLM serving
		// with OpenAI-compatible API. Supports continuous batching,
		// tensor parallelism, and GPU memory optimization.
		// Start with: python -m vllm.entrypoints.openai.api_server --model <model> --port 8000
		"vllm": {
			"baseUrl": "http://localhost:8000/v1",
			"api": "openai-completions",
			"apiKey": "vllm",
			"autoDiscover": "openai",
			"optionalApiKey": true,
			"models": []
		},

		// MLX LM (https://github.com/ml-explore/mlx-lm) - Apple Silicon
		// optimized LLM serving with OpenAI-compatible API.
		// Start with: mlx_lm.server --model <model> --port 8080
		"mlx": {
			"baseUrl": "http://localhost:8080/v1",
			"api": "openai-completions",
			"apiKey": "mlx",
			"autoDiscover": "openai",
			"optionalApiKey": true,
			"models": []
		},

		// MLX OpenAI Server (https://github.com/cubist38/mlx-openai-server)
		// - High-performance OpenAI-compatible server for MLX models.
		// Start with: mlx-openai-server launch --model-path <model> --port 8000
		"mlx-openai": {
			"baseUrl": "http://localhost:8000/v1",
			"api": "openai-completions",
			"apiKey": "mlx-openai",
			"autoDiscover": "openai",
			"optionalApiKey": true,
			"models": []
		},

		// vLLM-MLX (https://github.com/waybarrios/vllm-mlx) - OpenAI and
		// Anthropic compatible server for Apple Silicon. Supports continuous
		// batching, MCP tool calling, and multimodal support.
		// Start with: vllm-mlx serve <model> --port 8000
		"vllm-mlx": {
			"baseUrl": "http://localhost:8000/v1",
			"api": "openai-completions",
			"apiKey": "vllm-mlx",
			"autoDiscover": "openai",
			"optionalApiKey": true,
			"models": []
		},

		// Cloud providers. Run `/login` to add the API key; the key
		// is stored in auth.json (chmod 0o600), not in this file.
		// After `/login`, the provider is added here automatically.
		//
		// To add manually, fill in the apiKey (or use the
		// `optionalApiKey: true` flag for OAuth-only providers) and
		// uncomment the entry. See docs/providers.md for the full
		// list of built-in provider names.
		//
		// "anthropic": { "models": [] },
		// "openai": { "models": [] },
		// "google": { "models": [] }
	}
}
